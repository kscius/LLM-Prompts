{
  "mcpServers": {
    "Memory": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "YOUR_HOST_PATH_FOR_MEMORY:/data",
        "-e",
        "MEMORY_FILE_PATH=/data/memory.json",
        "mcp/memory"
      ]
    },
    "Sequential Thinking": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "mcp/sequentialthinking"]
    },
    "Interactive": {
      "command": "npx",
      "args": ["-y", "interactive-mcp", "-t", "300"],
      "timeout": 300
    },
    "duckduckgo": {
      "command": "npx",
      "args": ["-y", "duckduckgo-mcp-server"]
    },
    "time": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "YOUR_TIMEZONE", "mcp/time"]
    },
    "mtg-commander-analyzer": {
      "command": "YOUR_SHELL",
      "args": ["YOUR_ARGS_TO_RUN_LOCAL_MCP"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "semgrep": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "semgrep/semgrep", "semgrep", "mcp", "-t", "stdio"]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "cursor10x-mcp": {
      "command": "npx",
      "args": ["cursor10x-mcp"],
      "enabled": true,
      "env": {
        "TURSO_DATABASE_URL": "${CURSOR10X_TURSO_URL}",
        "TURSO_AUTH_TOKEN": "${CURSOR10X_TURSO_TOKEN}"
      }
    },
    "devcontext": {
      "command": "npx",
      "args": ["-y", "devcontext@latest"],
      "enabled": true,
      "env": {
        "TURSO_DATABASE_URL": "${DEVCONTEXT_TURSO_URL}",
        "TURSO_AUTH_TOKEN": "${DEVCONTEXT_TURSO_TOKEN}"
      }
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    }
  }
}
