{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node ./hooks/session-context.js",
        "timeout": 10
      },
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "afterAgentResponse": [
      {
        "command": "node ./hooks/after-agent-response.js",
        "timeout": 8,
        "matcher": "AgentResponse"
      }
    ],

    "afterAgentThought": [
      {
        "command": "node ./hooks/thought-logger.js",
        "timeout": 5,
        "matcher": "AgentThought"
      }
    ],

    "sessionEnd": [
      {
        "command": "node ./hooks/session-end.js",
        "timeout": 8
      },
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "beforeShellExecution": [
      {
        "command": "node ./hooks/block-dangerous-shell.js",
        "timeout": 10
      },
      {
        "command": "node ./hooks/protect-branch.js",
        "matcher": "git"
      },
      {
        "type": "prompt",
        "prompt": "Is this deployment, publish, or network-modifying command safe? Only allow if explicitly requested by the user and does not target production without approval. Command: $ARGUMENTS",
        "timeout": 10,
        "matcher": "npm publish|npx.*deploy|docker push|kubectl apply|kubectl delete|terraform apply|terraform destroy|fly deploy|vercel.*--prod|heroku push|ansible-playbook|aws s3 rm|aws s3 delete|gsutil rm|az storage"
      }
    ],

    "afterShellExecution": [
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "beforeReadFile": [
      {
        "command": "node ./hooks/block-secret-reads.js",
        "timeout": 5,
        "failClosed": true
      }
    ],

    "beforeTabFileRead": [
      {
        "command": "node ./hooks/block-secret-reads.js",
        "timeout": 5,
        "failClosed": true
      }
    ],

    "afterFileEdit": [
      {
        "command": "node ./hooks/edit-tracker.js",
        "timeout": 5
      },
      {
        "command": "node ./hooks/post-edit-quality.js",
        "timeout": 10
      },
      {
        "command": "node ./hooks/comment-checker.js",
        "timeout": 8
      },
      {
        "command": "node ./hooks/auto-format.js",
        "timeout": 15
      },
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      },
      {
        "type": "prompt",
        "prompt": "A critical file was just edited. Verify: (1) the change is within requested scope, (2) no secrets or credentials were introduced, (3) existing behavior outside the change scope was preserved. Edit: $ARGUMENTS",
        "timeout": 10,
        "matcher": "migration|auth|security|config|schema|\\.env"
      }
    ],

    "afterTabFileEdit": [
      {
        "command": "node ./hooks/post-edit-quality.js",
        "timeout": 10
      }
    ],

    "beforeMCPExecution": [
      {
        "command": "node ./hooks/validate-mcp.js",
        "timeout": 10,
        "failClosed": true
      }
    ],

    "afterMCPExecution": [
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "preToolUse": [
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5,
        "matcher": "Shell|Write|Delete"
      }
    ],

    "postToolUse": [
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "postToolUseFailure": [
      {
        "command": "node ./hooks/tool-failure-tracker.js",
        "timeout": 5
      }
    ],

    "subagentStart": [
      {
        "command": "node ./hooks/subagent-guard.js",
        "timeout": 5
      },
      {
        "type": "prompt",
        "prompt": "Review this subagent delegation. Is the task well-scoped with clear boundaries? Is delegation justified (specialized expertise, parallelizable, or high-risk)? Does it avoid redundant work the parent could do directly? Delegation: $ARGUMENTS",
        "timeout": 10,
        "matcher": "security-auditor|security-engineer|database-administrator|database-optimizer|penetration-tester|compliance-auditor"
      }
    ],

    "subagentStop": [
      {
        "command": "node ./hooks/subagent-complete.js",
        "timeout": 5
      }
    ],

    "stop": [
      {
        "command": "node ./hooks/stop-summary.js",
        "timeout": 10,
        "loop_limit": 5
      },
      {
        "command": "node ./hooks/verifier.js",
        "timeout": 90
      },
      {
        "command": "node ./hooks/boulder-check.js",
        "timeout": 15
      },
      {
        "command": "node ./hooks/audit-log.js",
        "timeout": 5
      }
    ],

    "preCompact": [
      {
        "command": "node ./hooks/precompact-preserve.js",
        "timeout": 15
      }
    ]
  }
}
